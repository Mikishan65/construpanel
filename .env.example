# ==============================================================
# Variables de Entorno para Despliegue en VPS (Construpanel)
# ==============================================================

# Puerto expuesto en el host del VPS:
# - Usa 80 si este contenedor atenderá directamente el tráfico HTTP.
# - Usa otro puerto (ej. 8080 o 3000) si tienes Nginx Proxy Manager / Traefik en el VPS.
PORT=80

# Dominio principal del sitio
DOMAIN=ccepcoin.construpanel.tech
